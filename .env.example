# Paste real values in Vercel → Settings → Environment Variables, not here.
# For local work copy this to .env.local (gitignored). Redeploy after any change.

# --- Vaani (voice) ---
VAANI_WEBHOOK_SECRET=       # any long random string; travels in the webhook URL as ?token=
VAANI_RATE_INR_PER_MIN=5    # your Vaani per-minute rate, for the cost column

# --- Gemini (classification) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # must be a Flash model currently open to new keys
GEMINI_INR_PER_M_INPUT=0        # 0 on the free tier
GEMINI_INR_PER_M_OUTPUT=0

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # the SECRET / service_role key, not the publishable one

# --- Resend (designer + front desk email) ---
RESEND_API_KEY=
EMAIL_FROM=Aangan Leads <onboarding@resend.dev>
FRONT_DESK_EMAIL=            # your Resend signup email; sandbox delivers nowhere else

# --- App ---
APP_URL=                     # https://your-app.vercel.app
LINK_SECRET=                 # another long random string; signs Claim / Reschedule links
DASHBOARD_PASSWORD=          # username is "aangan"
CALCOM_BOOKING_URL=          # optional fallback booking link

# --- HubSpot (optional; skipped entirely when empty) ---
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled

# There is deliberately no pricing variable, and no pricing.md in knowledge/.
# The agent cannot quote what it was never given.
